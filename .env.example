# Backend
APP_ENV=development
DATABASE_URL=sqlite:///./clinical_ai.db
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2

